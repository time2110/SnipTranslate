<Window x:Class="SnipTranslate.Capture.CaptureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Black"
        Cursor="Cross"
        PreviewKeyDown="OnPreviewKeyDown"
        PreviewKeyUp="OnPreviewKeyUp"
        PreviewMouseMove="OnWindowPreviewMouseMove"
        MouseLeave="OnWindowMouseLeave">
  <Window.Resources>
    <Style x:Key="ToolButton" TargetType="Button">
      <Setter Property="Height" Value="34" />
      <Setter Property="MinWidth" Value="42" />
      <Setter Property="Margin" Value="2" />
      <Setter Property="Padding" Value="9,0" />
      <Setter Property="FontFamily" Value="Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="#172033" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="5">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#DDEAF3FA" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#C7DDECFA" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <AdornerDecorator>
  <Grid x:Name="Root">
    <Grid x:Name="SurfaceHost" />

    <Border x:Name="ModeBadge"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="18"
            Padding="10,6"
            CornerRadius="6"
            Background="#DD111827"
            IsHitTestVisible="False">
      <TextBlock x:Name="ModeText" Foreground="White" FontSize="13" />
    </Border>

    <Canvas x:Name="OverlayCanvas">
      <Border x:Name="Toolbar"
              Canvas.Left="20"
              Canvas.Top="20"
              Height="42"
              Padding="4"
              CornerRadius="7"
              Background="#F4FFFFFF"
              BorderBrush="#44000000"
              BorderThickness="1"
              Visibility="Collapsed"
              IsHitTestVisible="True">
        <Border.Effect>
          <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3" />
        </Border.Effect>
        <StackPanel Orientation="Horizontal">
          <Button Style="{StaticResource ToolButton}" Content="&#xE718;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" ToolTip="贴图 (Space)" Click="OnPinClick" />
          <Button x:Name="PenButton" Style="{StaticResource ToolButton}" Content="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" ToolTip="画笔 (P)" Click="OnPenClick" />
          <Button x:Name="RectangleButton" Style="{StaticResource ToolButton}" Content="□" FontFamily="Segoe UI Symbol" FontSize="21" ToolTip="矩形 (R)" Click="OnRectangleClick" />
          <Button x:Name="ArrowButton" Style="{StaticResource ToolButton}" Content="↗" FontFamily="Segoe UI Symbol" FontSize="20" ToolTip="箭头 (A)" Click="OnArrowClick" />
          <Button x:Name="TextButton" Style="{StaticResource ToolButton}" Content="T" FontFamily="Segoe UI Semibold" FontSize="17" ToolTip="文字 (X)" Click="OnTextClick" />
          <Button Style="{StaticResource ToolButton}" Content="&#xE7A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" ToolTip="撤销 (Ctrl+Z)" Click="OnUndoClick" />
          <Button Style="{StaticResource ToolButton}" Content="▣" FontFamily="Segoe UI Symbol" FontSize="18" ToolTip="提取文字 OCR (O)" Click="OnOcrClick" />
          <Separator Margin="3,7" />
          <Button Style="{StaticResource ToolButton}" Content="&#xE74E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" ToolTip="保存 (Ctrl+S)" Click="OnSaveClick" />
          <Button Style="{StaticResource ToolButton}" Content="&#xE8C8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" ToolTip="复制 (Enter)" Click="OnCopyClick" />
          <Button Style="{StaticResource ToolButton}" Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17" ToolTip="取消 (Esc)" Click="OnCloseClick" />
        </StackPanel>
      </Border>

      <Border x:Name="ToolOptionsPanel"
              Canvas.Left="20"
              Canvas.Top="66"
              Height="40"
              Padding="7,4"
              CornerRadius="7"
              Background="#F4FFFFFF"
              BorderBrush="#44000000"
              BorderThickness="1"
              Visibility="Collapsed"
              IsHitTestVisible="True">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="颜色" VerticalAlignment="Center" Margin="2,0,6,0" Foreground="#334155" />
          <Button Content="●" Foreground="#EF4444" FontSize="20" Width="29" Tag="#EF4444" Click="OnColorClick" ToolTip="红色" />
          <Button Content="●" Foreground="#FACC15" FontSize="20" Width="29" Tag="#FACC15" Click="OnColorClick" ToolTip="黄色" />
          <Button Content="●" Foreground="#22C55E" FontSize="20" Width="29" Tag="#22C55E" Click="OnColorClick" ToolTip="绿色" />
          <Button Content="●" Foreground="#3B82F6" FontSize="20" Width="29" Tag="#3B82F6" Click="OnColorClick" ToolTip="蓝色" />
          <Button Content="●" Foreground="White" Background="#64748B" FontSize="20" Width="29" Tag="#FFFFFF" Click="OnColorClick" ToolTip="白色" />
          <Button Content="●" Foreground="#111827" FontSize="20" Width="29" Tag="#111827" Click="OnColorClick" ToolTip="黑色" />
          <Separator Margin="7,5" />
          <TextBlock Text="粗细" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#334155" />
          <ComboBox x:Name="ThicknessBox" Width="58" Height="28" SelectionChanged="OnAnnotationOptionChanged">
            <ComboBoxItem Content="2 px" Tag="2" />
            <ComboBoxItem Content="3 px" Tag="3" IsSelected="True" />
            <ComboBoxItem Content="5 px" Tag="5" />
            <ComboBoxItem Content="8 px" Tag="8" />
          </ComboBox>
          <StackPanel x:Name="TextOptions" Orientation="Horizontal" Visibility="Collapsed">
            <Separator Margin="7,5" />
            <TextBlock Text="字号" VerticalAlignment="Center" Margin="0,0,5,0" Foreground="#334155" />
            <ComboBox x:Name="FontSizeBox" Width="60" Height="28">
              <ComboBoxItem Content="12" Tag="12" />
              <ComboBoxItem Content="16" Tag="16" IsSelected="True" />
              <ComboBoxItem Content="20" Tag="20" />
              <ComboBoxItem Content="28" Tag="28" />
              <ComboBoxItem Content="36" Tag="36" />
            </ComboBox>
            <ToggleButton x:Name="BoldTextButton" Content="B" FontWeight="Bold" Width="30" Height="28" Margin="5,0,0,0" ToolTip="粗体" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border x:Name="ResultPanel"
              Canvas.Left="20"
              Canvas.Top="70"
              Width="430"
              Height="500"
              Padding="14"
              CornerRadius="10"
              Background="#F7FFFFFF"
              BorderBrush="#55000000"
              BorderThickness="1"
              Visibility="Collapsed"
              IsHitTestVisible="True"
              Cursor="Arrow"
              ForceCursor="True">
        <Border.Effect>
          <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.35" />
        </Border.Effect>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,12">
            <TextBlock Text="文字识别与翻译"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#172033"
                       VerticalAlignment="Center" />
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource ToolButton}"
                    MinWidth="32"
                    Content="×"
                    ToolTip="收起结果"
                    Click="OnCloseResultClick" />
          </DockPanel>

          <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,11">
            <ComboBox x:Name="SourceLanguageBox" Width="128" Height="30" SelectionChanged="OnLanguageChanged">
              <ComboBoxItem Content="自动识别" Tag="auto" IsSelected="True" />
              <ComboBoxItem Content="中文" Tag="zh-CN" />
              <ComboBoxItem Content="English" Tag="en" />
              <ComboBoxItem Content="日本語" Tag="ja" />
              <ComboBoxItem Content="한국어" Tag="ko" />
            </ComboBox>
            <Button Content="⇄" Width="34" Height="30" Margin="7,0" ToolTip="交换语言" Click="OnSwapLanguageClick" />
            <ComboBox x:Name="TargetLanguageBox" Width="142" Height="30" SelectionChanged="OnLanguageChanged">
              <ComboBoxItem Content="中英自动互译" Tag="bilingual" IsSelected="True" />
              <ComboBoxItem Content="简体中文" Tag="zh-CN" />
              <ComboBoxItem Content="English" Tag="en" />
              <ComboBoxItem Content="日本語" Tag="ja" />
              <ComboBoxItem Content="한국어" Tag="ko" />
            </ComboBox>
            <Button x:Name="TranslateOcrButton"
                    Content="翻译"
                    Height="30"
                    Padding="13,0"
                    Margin="7,0,0,0"
                    Background="#0284C7"
                    Foreground="White"
                    BorderThickness="0"
                    Click="OnTranslateOcrClick" />
          </StackPanel>

          <Grid Grid.Row="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6">
              <TextBlock Text="OCR 原文" FontWeight="SemiBold" Foreground="#334155" />
              <TextBlock x:Name="TimingText" DockPanel.Dock="Right" Foreground="#64748B" HorizontalAlignment="Right" />
            </DockPanel>
            <TextBox x:Name="SourceText"
                     Grid.Row="1"
                     Padding="9"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="#F8FAFC"
                     BorderBrush="#CBD5E1" />
          </Grid>

          <TextBlock x:Name="TranslationHeading"
                     Grid.Row="3"
                     Margin="0,11,0,6"
                     Text="Google 译文"
                     FontWeight="SemiBold"
                     Foreground="#334155" />
          <TextBox x:Name="TranslatedText"
                   Grid.Row="4"
                   Padding="9"
                   AcceptsReturn="True"
                   TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto"
                   Background="#F8FAFC"
                   BorderBrush="#CBD5E1" />

          <Grid Grid.Row="5" Margin="0,12,0,0">
            <TextBlock x:Name="ResultStatusText"
                       VerticalAlignment="Center"
                       Foreground="#64748B"
                       TextTrimming="CharacterEllipsis" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="复制原文" Padding="11,6" Margin="0,0,7,0" Click="OnCopySourceClick" />
              <Button x:Name="RetranslateButton" Content="重新翻译" Padding="11,6" Margin="0,0,7,0" Click="OnRetranslateClick" />
              <Button x:Name="CopyTranslationButton" Content="复制译文" Padding="11,6" Click="OnCopyTranslationClick" />
            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Canvas>
  </Grid>
  </AdornerDecorator>
</Window>
