<Window x:Class="SnipTranslate.Translation.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="识别结果"
        Width="520"
        Height="420"
        MinWidth="360"
        MinHeight="260"
        WindowStartupLocation="Manual"
        Topmost="True"
        Background="#F8FAFC">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Margin="0,0,0,7">
      <TextBlock Text="识别原文" FontSize="14" FontWeight="SemiBold" Foreground="#172033" />
      <TextBlock x:Name="TimingText" DockPanel.Dock="Right" Foreground="#64748B" HorizontalAlignment="Right" />
    </DockPanel>
    <TextBox x:Name="SourceText"
             Grid.Row="1"
             Padding="10"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             IsReadOnly="True" />

    <TextBlock x:Name="TranslationHeading"
               Grid.Row="2"
               Margin="0,14,0,7"
               Text="Google 译文"
               FontSize="14"
               FontWeight="SemiBold"
               Foreground="#172033" />
    <TextBox x:Name="TranslatedText"
             Grid.Row="3"
             Padding="10"
             AcceptsReturn="True"
             TextWrapping="Wrap"
             VerticalScrollBarVisibility="Auto"
             IsReadOnly="True" />

    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button Content="复制结果" Padding="16,7" Margin="0,0,8,0" Click="OnCopyClick" />
      <Button Content="关闭" Padding="16,7" Click="OnCloseClick" />
    </StackPanel>
  </Grid>
</Window>

