<Window x:Class="SnipTranslate.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnipTranslate 设置" Width="840" Height="760" MinWidth="760" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="#F8FAFC">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="0,0,8,0">
        <TextBlock Text="常规" FontSize="22" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,14" />
        <CheckBox x:Name="StartupBox" Content="开机自动启动 SnipTranslate" />
        <TextBlock Margin="22,6,0,0" Foreground="#64748B" Text="登录当前 Windows 用户后在后台运行，无需管理员权限。" />
        <Grid Margin="0,16,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="200" /><ColumnDefinition Width="110" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="全局快捷键" />
          <TextBox x:Name="CaptureHotkeyBox" Grid.Column="1" Height="30" Padding="7,4" IsReadOnly="True"
                   ToolTip="点击后直接按下新的组合键" PreviewKeyDown="OnCaptureHotkeyKeyDown" />
          <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="18,0,0,0" Text="截图翻译" />
          <TextBox x:Name="TranslateHotkeyBox" Grid.Column="3" Height="30" Padding="7,4" IsReadOnly="True"
                   ToolTip="点击后直接按下新的组合键" PreviewKeyDown="OnTranslateHotkeyKeyDown" />
        </Grid>
        <TextBlock Margin="125,6,0,0" Foreground="#64748B" Text="点击输入框并按下组合键；F1–F12 可以不加修饰键。" />
        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="200" /><ColumnDefinition Width="110" /><ColumnDefinition Width="200" /></Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="默认 OCR 语言" />
          <ComboBox x:Name="OcrLanguageBox" Grid.Column="1" Height="30">
            <ComboBoxItem Content="自动/中英日" Tag="auto" />
            <ComboBoxItem Content="中文/English/日本語" Tag="zh" />
            <ComboBoxItem Content="English 优先" Tag="en" />
            <ComboBoxItem Content="한국어 韩语" Tag="ko" />
          </ComboBox>
          <CheckBox x:Name="OcrAngleBox" Grid.Column="2" Grid.ColumnSpan="2" Margin="18,0,0,0"
                    VerticalAlignment="Center" Content="识别旋转文字" />
        </Grid>
        <Separator Margin="0,20,0,17" />
        <TextBlock Text="翻译服务" FontSize="22" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,18" />
        <Grid Margin="0,0,0,12">
          <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="默认目标语言" />
          <ComboBox x:Name="TargetLanguageBox" Grid.Column="1" Height="30">
            <ComboBoxItem Content="简体中文" Tag="zh-CN" /><ComboBoxItem Content="繁体中文" Tag="zh-TW" />
            <ComboBoxItem Content="英语" Tag="en" /><ComboBoxItem Content="日语" Tag="ja" /><ComboBoxItem Content="韩语" Tag="ko" />
          </ComboBox>
        </Grid>
        <CheckBox x:Name="FallbackBox" Margin="125,0,0,10" IsChecked="True"
                  Content="失败时自动尝试列表中的下一个接口" />
        <Border Padding="12" CornerRadius="7" Background="White" BorderBrush="#CBD5E1" BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="275" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="0,0,12,0">
              <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
              <TextBlock x:Name="ProviderListTitle" Text="已添加接口" FontWeight="SemiBold" Foreground="#334155" Margin="2,0,0,8" />
              <ListBox x:Name="ProviderOrderBox" Grid.Row="1" MinHeight="210" MaxHeight="360" Padding="2"
                       AllowDrop="True" SelectionChanged="OnProviderSelectionChanged"
                       PreviewMouseLeftButtonDown="OnProviderOrderMouseDown" PreviewMouseMove="OnProviderOrderMouseMove"
                       Drop="OnProviderOrderDrop" />
              <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,9,0,0">
                <Button Content="＋ 添加接口" Padding="11,5" Margin="0,0,7,0" Click="OnAddProviderClick" />
                <Button Content="删除" Padding="13,5" Click="OnDeleteProviderClick" />
              </StackPanel>
              <TextBlock Grid.Row="3" Margin="2,8,0,0" Foreground="#64748B" TextWrapping="Wrap"
                         Text="这里是已添加的接口实例，可拖动排序；空心圆表示已停用。" />
            </Grid>
            <Border Grid.Column="1" Background="#E2E8F0" />
            <StackPanel Grid.Column="2" Margin="16,0,0,0">
              <TextBlock Text="所选接口配置" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,8" />
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="显示名称" /><TextBox x:Name="ProviderNameBox" Grid.Column="1" Height="30" Padding="6,3" />
              </Grid>
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="服务类型" />
                <ComboBox x:Name="ProviderBox" Grid.Column="1" Height="30" SelectionChanged="OnProviderChanged">
                  <ComboBoxItem Content="Google Web（免 Key）" /><ComboBoxItem Content="微软/Bing Translator" />
                  <ComboBoxItem Content="LibreTranslate" /><ComboBoxItem Content="MyMemory（免 Key）" /><ComboBoxItem Content="自定义 HTTP API" />
                </ComboBox>
              </Grid>
              <CheckBox x:Name="ProviderEnabledBox" Margin="96,10,0,0" IsChecked="True" Content="启用此接口" />
              <Grid x:Name="EndpointRow" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="API 地址" /><TextBox x:Name="EndpointBox" Grid.Column="1" Height="30" Padding="6,3" />
              </Grid>
              <Grid x:Name="ApiKeyRow" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock x:Name="ApiKeyLabel" VerticalAlignment="Center" Text="API Key" /><PasswordBox x:Name="ApiKeyBox" Grid.Column="1" Height="30" Padding="6,3" />
              </Grid>
              <Grid x:Name="RegionRow" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Azure 区域" /><TextBox x:Name="RegionBox" Grid.Column="1" Height="30" Padding="6,3" ToolTip="例如 eastasia；全局资源可留空" />
              </Grid>
              <Grid x:Name="ApiKeyHeaderRow" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="Key 请求头" /><TextBox x:Name="ApiKeyHeaderBox" Grid.Column="1" Height="30" Padding="6,3" />
              </Grid>
              <Grid x:Name="RequestTemplateRow" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Top" Margin="0,5,0,0" Text="JSON 模板" />
                <TextBox x:Name="RequestTemplateBox" Grid.Column="1" Height="66" Padding="6,5" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
              </Grid>
              <Grid x:Name="ResponsePathRow" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Text="译文路径" /><TextBox x:Name="ResponsePathBox" Grid.Column="1" Height="30" Padding="6,3" />
              </Grid>
              <TextBlock x:Name="ProviderHint" Margin="96,7,0,0" Foreground="#64748B" TextWrapping="Wrap" />
              <Button Content="保存此接口" HorizontalAlignment="Right" Padding="14,6" Margin="0,12,0,0" Click="OnApplyProviderClick" />
              <TextBlock Margin="96,7,0,0" Foreground="#64748B" TextWrapping="Wrap"
                         Text="服务类型共有 5 种；左侧数量是已添加实例数，同一种类型可添加多次。" />
            </StackPanel>
          </Grid>
        </Border>
        <Separator Margin="0,22,0,17" />
        <TextBlock Text="网络代理" FontSize="18" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,14" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="代理模式" />
          <ComboBox x:Name="ProxyModeBox" Grid.Column="1" Height="30" SelectionChanged="OnProxyModeChanged">
            <ComboBoxItem Content="跟随 Windows 系统代理" /><ComboBoxItem Content="不使用代理" /><ComboBoxItem Content="自定义代理" />
          </ComboBox>
        </Grid>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="代理协议" />
          <ComboBox x:Name="ProxySchemeBox" Grid.Column="1" Height="30"><ComboBoxItem Content="http" /><ComboBoxItem Content="https" /><ComboBoxItem Content="socks5" /></ComboBox>
        </Grid>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="主机 / 端口" />
          <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions>
            <TextBox x:Name="ProxyHostBox" Height="30" Padding="6,3" /><TextBox x:Name="ProxyPortBox" Grid.Column="2" Height="30" Padding="6,3" />
          </Grid>
        </Grid>
        <Grid Margin="0,12,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="125" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="用户名 / 密码" />
          <Grid Grid.Column="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBox x:Name="ProxyUsernameBox" Height="30" Padding="6,3" /><PasswordBox x:Name="ProxyPasswordBox" Grid.Column="2" Height="30" Padding="6,3" />
          </Grid>
        </Grid>
        <Border Margin="0,18,0,12" MinHeight="70" Padding="11,9" CornerRadius="6" Background="#EEF2F7" BorderBrush="#CBD5E1" BorderThickness="1">
          <TextBlock x:Name="StatusText" Text="选择翻译服务后，可在这里测试连接。" TextWrapping="Wrap" Foreground="#475569" />
        </Border>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,8,0">
      <Button x:Name="TestButton" Content="测试翻译" Padding="14,7" Margin="0,0,8,0" Click="OnTestClick" />
      <Button Content="保存全部" Padding="18,7" Margin="0,0,8,0" Click="OnSaveClick" /><Button Content="取消" Padding="18,7" Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>
